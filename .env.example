# Smoothie AI frontend environment variables.
# These are inlined into the browser bundle at build time.
# Never put secrets here: anything prefixed with VITE_ is public.

# Backend API origin (deployed Flask service). Always ends with exactly one /api.
# Example: https://smoothie-ai-api.onrender.com/api
VITE_API_BASE_URL=http://localhost:5000/api

# Optional request timeout in milliseconds (default 20000).
VITE_API_TIMEOUT_MS=20000
